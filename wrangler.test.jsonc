{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summitclub-booking-test",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [{ "pattern": "test.summitclub.co", "custom_domain": true }],
  "assets": { "directory": "./dist/test", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "BOOKINGS", "class_name": "BookingStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingStore"] }],
  "vars": {
    "BASE_URL": "https://test.summitclub.co",
    "PAYMENTS_MODE": "test",
    "EMAIL_DELIVERY": "on",
    "OWNER_EMAIL": "summit.club.ni@gmail.com",
    "TESTER_EMAILS": "summit.club.ni@gmail.com,catriona@temperedthinking.com"
  }
}
